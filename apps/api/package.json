{
  "name": "@autovoyage/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:watch": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "@autovoyage/shared": "0.1.0",
    "@electric-sql/pglite": "^0.3.14",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@napi-rs/canvas": "^1.1.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.16.3",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6"
  }
}
