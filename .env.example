NODE_ENV=development
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
TZ=Asia/Shanghai
# pglite runs real PostgreSQL locally; use postgres for the hosted database.
DATABASE_DRIVER=pglite
PGLITE_PATH=../../.local/postgres
PGHOST=117.72.124.241
PGPORT=5432
PGDATABASE=mem_car_info
PGUSER=mem_car_app
PGPASSWORD=
PGSSL=false
DEMO_MODE=true
SEED_DEMO=true
DEMO_PASSWORD=Yuncheng2026!
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
UPLOAD_DIR=../../.local/uploads
# AI_BASE_URL is the provider API root, e.g. https://provider.example/v1.
# Use responses for POST /responses or chat_completions for POST /chat/completions.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_API_STYLE=chat_completions
AI_TIMEOUT_MS=90000
# OSM is available for local preview; AMap is recommended for China deployment.
MAP_PROVIDER=osm
AMAP_WEB_KEY=
AMAP_SECURITY_CODE=
